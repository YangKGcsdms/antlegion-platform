{
  "name": "@antlegion/dsh",
  "version": "0.2.0",
  "description": "The AntLegion plugin for DeepSeek Harness: run dsh as a DCU mounted on the fact bus — it stands watch, responds to facts on the log by itself, and publishes what it did back as facts.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "antlegion-dcu-check": "check.js"
  },
  "files": [
    "index.js",
    "tools.js",
    "patrol.js",
    "resident.js",
    "preflight.js",
    "check.js",
    "cordis.patch.yml",
    "README.md",
    "GUIDE.zh-CN.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@antlegion/bus": "^0.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "dsh-plugin",
    "antlegion",
    "dcu",
    "fact-bus",
    "multi-agent"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test.mjs"
  }
}
